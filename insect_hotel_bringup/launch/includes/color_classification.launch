<?xml version="1.0" ?>
<launch>
    <arg name="namespace"          default="mobipick"/>
    <arg name="class_ids_config"   default="$(find pbr_objects)/config/class_ids.yaml"   doc="Path to class ids config file"/>
    <arg name="draw_colors_config" default="$(find pbr_objects)/config/draw_colors.yaml" doc="Path to marker draw colors config file"/>
    <arg name="meshes_config"      default="$(find pbr_objects)/config/meshes.yaml"      doc="Path to meshes config file"/>

    <arg name="visualize_histograms" default="false" doc="Set to true to visualize the color histograms using cv::imshow"/>

    <group ns="$(arg namespace)">
      <node name="color_classification_node" pkg="daa_color_classification" type="color_classification_node" output="screen">
        <param name="visualize_histograms" value="$(arg visualize_histograms)"/>
      </node>

      <!-- NB: the output of the color_object_publisher is currently unused, because the pick_pose_selector_node
           subscribes to the output of the fake_anchoring_node instead -->
      <node name="color_object_publisher" pkg="daa_color_classification" type="color_object_publisher.py" output="screen">
        <rosparam file="$(arg class_ids_config)" />
      </node>

      <node name="fake_anchoring_node" pkg="daa_color_classification" type="fake_anchoring_node.py" output="screen">
        <rosparam file="$(arg class_ids_config)" />
        <remap from="dope/detected_objects" to="detected_objects_plus_colorparts" />
      </node>

      <!-- visualization of the color_object_publisher output -->
      <node name="detection3d_to_markers" pkg="daa_tools" type="detection3d_to_markers.py" output="screen">
        <rosparam file="$(arg class_ids_config)" />
        <rosparam file="$(arg draw_colors_config)" />
        <rosparam file="$(arg meshes_config)" />

        <remap from="detected_objects" to="detected_objects_plus_colorparts" />
        <remap from="markers" to="markers_plus_colorparts" />
      </node>
    </group>
</launch>
